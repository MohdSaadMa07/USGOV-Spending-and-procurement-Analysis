# =============================================================================
# USAspending Analytics — Environment Configuration
# Copy to .env and fill values. Never commit .env (already in .gitignore).
# All code reads via app/config.py (python-dotenv) — no localhost hardcoded.
# =============================================================================

# --- SQL Server (source of truth; Power BI uses same values) ---------------
# Host / instance — e.g. localhost, localhost\SQLEXPRESS, 127.0.0.1,1433
# For Azure SQL later: yourserver.database.windows.net
SQL_SERVER=localhost
SQL_DATABASE=USAspendingDB
SQL_DRIVER=ODBC Driver 18 for SQL Server

# SQL auth — leave empty to use Windows Trusted_Connection (local dev)
# For Azure SQL / remote: set both to use UID/PWD
SQL_USERNAME=
SQL_PASSWORD=

# Optional — only needed if you want to override defaults
# SQL_TRUSTED_CONNECTION=yes
# SQL_TRUST_SERVER_CERTIFICATE=yes
# SQL_CONNECTION_TIMEOUT=30
# SQL_QUERY_TIMEOUT=30
# MAX_ROWS=500

# --- API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=8000

# --- Text-to-SQL LLM -------------------------------------------------------
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
# Optional OpenAI-compatible endpoint override for the selected provider.
# LLM_BASE_URL=

# --- LLM (Phase 3+ — not used in Phase 2) --------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
